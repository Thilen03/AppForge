# Local publishing allowlist: everything else stays private.
/*
!/.gitignore
!/src/
!/docs/
!/packaging/
!/scripts/
!/tests/
!/README.md
!/pyproject.toml
!/requirements.txt
!/requirements-dev.txt
!/requirements-build.txt

# Also exclude private/generated files within approved directories.
.env*
*.env
.venv/
.venv-*/
venv/
env/
build/
dist/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache/
.idea/
.vscode/
.DS_Store
*~
*.swp
*.swo
*.tmp
*.temp
*.log
*.pem
*.key
*.p12
*.pfx
credentials.json
credentials/
credentials.*
secrets/
secrets.*
.aws/
.ssh/
.gnupg/
node_modules/
*.AppImage
*.so
*.o
*.zip
*.tar
*.tar.*
*.sqlite*
*.db
*.bak
AGENTS.md
development-instructions.md
roadmap.md
RELEASE_NOTES*.md

# Only public versioned release notes are eligible within releases/.
!/releases/
/releases/*
!/releases/RELEASE_NOTES_v*.md
